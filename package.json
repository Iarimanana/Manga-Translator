{
  "name": "manga-translator",
  "version": "1.0.0",
  "private": true,
  "description": "Translate manga, manhwa and manhua right on the page — a Chrome extension powered by Claude.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && node scripts/package.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
